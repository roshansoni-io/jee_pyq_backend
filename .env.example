# Copy to .env and set a unique, strong password before starting the stack.
POSTGRES_DB=pyq
POSTGRES_USER=pyq
POSTGRES_PASSWORD=replace-with-a-long-random-secret

# Defaults bind the API to loopback. Set to 0.0.0.0 only when an external
# firewall or trusted reverse proxy controls public access.
PYQ_BIND_ADDRESS=127.0.0.1
PYQ_PORT=8000
PYQ_WORKERS=1
PYQ_DB_POOL_SIZE=5
PYQ_DB_POOL_MAX_OVERFLOW=5
